{
  "name": "Wan2.1_I2V_14B_720p_Production_Workflow",
  "version": "2.1.0",
  "description": "ComfyUI workflow for Wan 2.1 14B Image-to-Video with high-speed FP8 inference, reference image guidance, and R2 cloud export",
  "model_specs": {
    "model_name": "Wan2.1-I2V-14B-720P",
    "checkpoint_fp8": "Wan2.1_I2V_14B_720P_fp8.safetensors",
    "t5_text_encoder": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
    "vae": "wan2.1_vae.safetensors",
    "clip_vision": "clip_vision_h.safetensors",
    "default_resolution": {
      "width": 1280,
      "height": 720,
      "fps": 16
    },
    "vram_requirement_gb": 24,
    "recommended_gpus": ["RTX_4090", "RTX_3090", "L40S", "RTX_6000_Ada", "A100_SXM4"]
  },
  "nodes": {
    "1": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model_name": "Wan2.1_I2V_14B_720P_fp8.safetensors",
        "precision": "fp8_e4m3fn",
        "device": "cuda",
        "offload_device": "cpu"
      }
    },
    "2": {
      "class_type": "WanVideoVAELoader",
      "inputs": {
        "vae_name": "wan2.1_vae.safetensors"
      }
    },
    "3": {
      "class_type": "WanVideoT5Loader",
      "inputs": {
        "t5_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "device": "cuda"
      }
    },
    "4": {
      "class_type": "LoadImageFromURL",
      "inputs": {
        "image_url": "{{KEYFRAME_IMAGE_URL}}",
        "upload_type": "input"
      }
    },
    "5": {
      "class_type": "WanVideoTextEncode",
      "inputs": {
        "t5": ["3", 0],
        "positive_prompt": "{{POSITIVE_PROMPT}}",
        "negative_prompt": "{{NEGATIVE_PROMPT}}",
        "character_ref_tags": "{{CHARACTER_REF_TAGS}}"
      }
    },
    "6": {
      "class_type": "WanVideoImageToVideo",
      "inputs": {
        "vae": ["2", 0],
        "image": ["4", 0],
        "width": 1280,
        "height": 720,
        "num_frames": "{{FRAME_COUNT}}",
        "fps": 16
      }
    },
    "7": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "latent_video": ["6", 0],
        "seed": "{{RANDOM_SEED}}",
        "steps": 25,
        "cfg": 6.0,
        "shift": 5.0,
        "scheduler": "unipc"
      }
    },
    "8": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "vae": ["2", 0],
        "samples": ["7", 0]
      }
    },
    "9": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": ["8", 0],
        "frame_rate": 16,
        "loop_count": 0,
        "filename_prefix": "tora_wan21_{{SHOT_ID}}",
        "format": "video/h264-mp4",
        "crf": 19,
        "pix_fmt": "yuv420p"
      }
    },
    "10": {
      "class_type": "CloudflareR2DirectUpload",
      "inputs": {
        "video": ["9", 0],
        "r2_bucket": "{{R2_BUCKET}}",
        "r2_key": "dramas/{{DRAMA_ID}}/episodes/{{EPISODE_ID}}/shots/shot_{{SHOT_ID}}.mp4",
        "notify_webhook": "{{BACKEND_WEBHOOK_URL}}"
      }
    }
  },
  "runtime_formula": {
    "fps": 16,
    "frame_count_formula": "Math.round(duration_seconds * 16) + 1",
    "typical_durations": {
      "3_seconds": 49,
      "5_seconds": 81,
      "8_seconds": 129,
      "10_seconds": 161
    }
  }
}
