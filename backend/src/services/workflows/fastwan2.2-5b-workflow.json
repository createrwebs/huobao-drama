{
  "name": "FastWan2.2_5B_FullAttn_3Step_Workflow",
  "version": "1.0.0",
  "huggingface_repo": "FastVideo/FastWan2.2-TI2V-5B-FullAttn-Diffusers",
  "description": "Ultra-fast 3-step distilled TI2V model using DMD (Diffusion Model Distillation) for 3-5 second inference per shot",
  "model_specs": {
    "model_name": "FastWan2.2-TI2V-5B-FullAttn-Diffusers",
    "parameters": "5B",
    "inference_steps": 3,
    "recommended_vram_gb": 16,
    "recommended_gpus": ["RTX_4070_Ti_Super", "RTX_4080", "RTX_3090", "RTX_4090"],
    "native_fps": 16,
    "avg_render_sec_per_shot": 4.5,
    "default_resolution": {
      "width": 1280,
      "height": 704
    }
  },
  "nodes": {
    "1": {
      "class_type": "FastWanModelLoader",
      "inputs": {
        "repo_id": "FastVideo/FastWan2.2-TI2V-5B-FullAttn-Diffusers",
        "torch_dtype": "bfloat16",
        "device": "cuda"
      }
    },
    "2": {
      "class_type": "LoadImageFromURL",
      "inputs": {
        "image_url": "{{KEYFRAME_IMAGE_URL}}"
      }
    },
    "3": {
      "class_type": "FastWanConditioning",
      "inputs": {
        "image": ["2", 0],
        "prompt": "{{POSITIVE_PROMPT}}",
        "negative_prompt": "{{NEGATIVE_PROMPT}}",
        "num_frames": "{{FRAME_COUNT}}",
        "fps": 16
      }
    },
    "4": {
      "class_type": "FastWan3StepSampler",
      "inputs": {
        "model": ["1", 0],
        "conditioning": ["3", 0],
        "steps": 3,
        "guidance_scale": 1.0,
        "seed": "{{RANDOM_SEED}}"
      }
    },
    "5": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": ["4", 0],
        "frame_rate": 16,
        "filename_prefix": "tora_fastwan_{{SHOT_ID}}",
        "format": "video/h264-mp4"
      }
    },
    "6": {
      "class_type": "CloudflareR2DirectUpload",
      "inputs": {
        "video": ["5", 0],
        "r2_bucket": "{{R2_BUCKET}}",
        "r2_key": "dramas/{{DRAMA_ID}}/episodes/{{EPISODE_ID}}/shots/shot_{{SHOT_ID}}.mp4"
      }
    }
  }
}
